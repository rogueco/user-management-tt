@using UserManagement.Web.Models.Users
@model UserDetailsViewModel
@{
    ViewData["Title"] = "User Details";
}

<h2>User Details</h2>

<partial name="_UserDetails" model="Model.User" />

<a asp-action="Edit" asp-route-id="@Model.User.Id" class="btn btn-primary">Edit</a>
<a asp-action="Delete" asp-route-id="@Model.User.Id" class="btn btn-danger">Delete</a>
<a asp-action="List" class="btn btn-secondary">Back to list</a>

<h3 class="mt-4">Recent activity</h3>

<partial name="_LogTable" model="Model.Logs" />

@if (Model.TotalLogs > Model.Logs.Count)
{
    <a asp-controller="Logs" asp-action="List" asp-route-userId="@Model.User.Id">View all @Model.TotalLogs entries</a>
}
