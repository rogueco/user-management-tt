@using UserManagement.Web.Models.Logs
@model LogListViewModel

@if (Model.TotalPages > 1)
{
    <nav aria-label="Log pages">
        <ul class="pagination">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="List" asp-all-route-data="@Model.RouteValues(Model.Page - 1)">Previous</a>
            </li>
            <li class="page-item disabled">
                <span class="page-link">Page @Model.Page of @Model.TotalPages</span>
            </li>
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="List" asp-all-route-data="@Model.RouteValues(Model.Page + 1)">Next</a>
            </li>
        </ul>
    </nav>
}
