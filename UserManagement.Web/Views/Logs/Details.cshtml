@using System.Globalization
@using UserManagement.Web.Models.Logs
@model LogViewModel
@{
    ViewData["Title"] = "Log Entry";
}

<h2>Log Entry</h2>

<dl class="row">
    <dt class="col-sm-3">When (UTC)</dt>
    <dd class="col-sm-9">@Model.Timestamp.ToString("dd/MM/yyyy HH:mm:ss", CultureInfo.InvariantCulture)</dd>

    <dt class="col-sm-3">Action</dt>
    <dd class="col-sm-9">@Model.Action</dd>

    <dt class="col-sm-3">User</dt>
    <dd class="col-sm-9">@Model.UserName (@Model.Email)</dd>

    <dt class="col-sm-3">User Id</dt>
    <dd class="col-sm-9">@Model.UserId</dd>
</dl>

<h3>Changes</h3>

@if (!Model.Changes.Any())
{
    <p class="text-muted">No fields changed.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Field</th>
                <th>Before</th>
                <th>After</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var change in Model.Changes)
            {
                <tr>
                    <td>@change.Field</td>
                    <td>@change.Before</td>
                    <td>@change.After</td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-action="List" class="btn btn-secondary">Back to logs</a>
@if (Model.UserExists)
{
    <a asp-controller="Users" asp-action="Details" asp-route-id="@Model.UserId" class="btn btn-secondary">View user</a>
}
