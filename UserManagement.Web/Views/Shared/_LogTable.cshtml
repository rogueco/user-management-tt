@using System.Globalization
@using UserManagement.Web.Models.Logs
@model IEnumerable<LogViewModel>

<div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>When (UTC)</th>
                <th>Action</th>
                <th>User</th>
                <th>Email</th>
                <th style="width: 1px;"></th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-muted">No log entries found.</td>
                </tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Timestamp.ToString("dd/MM/yyyy HH:mm:ss", CultureInfo.InvariantCulture)</td>
                    <td>@item.Action</td>
                    <td>@item.UserName</td>
                    <td>@item.Email</td>
                    <td>
                        <a asp-controller="Logs" asp-action="Details" asp-route-id="@item.Id" class="btn btn-secondary btn-sm">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
